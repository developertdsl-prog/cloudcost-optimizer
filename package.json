{
  "name": "cloudcost-optimizer",
  "version": "1.0.0",
  "description": "Multi-Cloud FinOps Platform, Kubernetes Pod Right-Sizing & Spot Arbitrage Engine",
  "main": "server/server.js",
  "scripts": {
    "start": "node server/server.js",
    "dev": "nodemon server/server.js",
    "seed": "node server/utils/seedCloudCost.js",
    "test": "jest --runInBand --detectOpenHandles --forceExit"
  },
  "keywords": [
    "finops",
    "cloud-cost",
    "kubernetes",
    "right-sizing",
    "spot-arbitrage",
    "waste-elimination",
    "aws",
    "gcp",
    "azure"
  ],
  "author": "developertdsl-prog <developer.tdsl@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "mongoose": "^7.6.3",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.0.1",
    "supertest": "^6.3.3"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/server/tests/**/*.test.js"
    ],
    "verbose": true,
    "testTimeout": 10000
  }
